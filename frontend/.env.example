# =========================================================================
# FRONTEND — exposed to browser (prefix with VITE_)
# =========================================================================
# Production UI: https://zora-trader-run-v1.web.app
#
# MUST be the Express backend Cloud Run service, e.g.:
#   https://zora-bot-service-208995792653.us-central1.run.app
#
# Do NOT use AI Studio preview hosts (ais-dev-*.run.app / ais-pre-*.run.app)
# for VITE_API_BASE_URL — those serve HTML, not the trading API.
VITE_API_BASE_URL=https://zora-bot-service-208995792653.us-central1.run.app
VITE_ALLOW_MOCK_MODE=false

# Firebase web app (zora-trader-run-v1)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=zora-trader-run-v1
VITE_FIREBASE_AUTH_DOMAIN=zora-trader-run-v1.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

GEMINI_API_KEY=
