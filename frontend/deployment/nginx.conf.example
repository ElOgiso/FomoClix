server {
    listen 80;
    server_name your-domain.com; # Replace with your domain or server IP

    # Root directory pointing to Vite's production build folder
    root /var/www/zora-trading-bot/dist;
    index index.html;

    # Handle SPA routing: serve static files, fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy WebSocket status requests (if any upgrade/connection header is needed)
    location /status/websocket {
        proxy_pass http://127.0.0.1:8080/status/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy API & Webhook requests to the Node Express service
    location ~ ^/(status|trades|positions|bot|trade|config|zora|activity-feed|target-users|webhook|performance|api) {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
