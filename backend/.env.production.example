# DigitalOcean / Cloud Run production environment.
# Copy to .env.production (or set as Cloud Run env/secrets) and fill real values.

# Public hostname used by Caddy for HTTPS. Example: bot.example.com
BOT_DOMAIN=

# Runtime
NODE_ENV=production
PORT=8080
DATABASE_MODE=firestore
# SQLITE_DB_PATH=/data/bot.db

# Required trading/runtime secrets
PRIVATE_KEY=
# Alternative accepted by index.js:
# ZORA_TRADER_PK=
ALCHEMY_RPC_URL=
NEYNAR_API_KEY=
NEYNAR_WEBHOOK_SECRET=
JWT_SECRET=
WALLET_ENCRYPTION_KEY=
GEMINI_API_KEY=
# Optional OpenAI failover for AI OS
# OPENAI_API_KEY=
ZORA_READ_API_KEY=

# Admin access
ADMIN_WALLETS=
ADMIN_EMAIL=
ADMIN_UID=

# CORS origins — must include the Firebase frontend host
# Production UI: https://zora-trader-run-v1.web.app
# Express API example: https://zora-bot-service-208995792653.us-central1.run.app
# Note: ais-dev / ais-pre hosts are AI Studio app shells, NOT this Express API.
CORS_ALLOWED_ORIGIN=https://zora-trader-run-v1.web.app,https://zora-trader-run-v1.firebaseapp.com

# Trading config
VAULT_ADDRESS=
TRADE_CURRENCY=ETH
TRADE_SLIPPAGE=0.0025
MINIMUM_HOLD_MINUTES=5
TRADE_AMOUNT_ETH=0.0002
CONTENT_TRADE_ETH=0.0002
CREATOR_TRADE_ETH=0.01
TRADE_AMOUNT_USDC=1000000
AUTO_WITHDRAW=false
MIN_PROFIT_BEFORE_WITHDRAW=0
SELL_AFTER_USERS=1
MAX_PRIORITY_FEE_GWEI=0.05
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
